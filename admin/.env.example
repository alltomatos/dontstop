# Gateway URL reachable from the Next.js server.
DONTSTOP_GATEWAY_URL=http://127.0.0.1:8080

# API key with the "manage" scope. Never expose this to the browser.
DONTSTOP_ADMIN_API_KEY=sk-ds-replace-with-a-manage-key

# Set to "required" to force login with a manage-scoped key.
DONTSTOP_CONSOLE_AUTH=off
