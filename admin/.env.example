# Gateway URL reachable from the Next.js server.
DONTSTOP_GATEWAY_URL=http://127.0.0.1:8080

# API key with the "manage" scope. Never expose this to the browser.
DONTSTOP_ADMIN_API_KEY=sk-ds-replace-with-a-manage-key

# Console login is required unless explicitly "off".
DONTSTOP_CONSOLE_AUTH=on

# Canonical public URL shown in the console. Do not include /v1.
DONTSTOP_PUBLIC_BASE_URL=https://gateway.dontstop.corp

# Optional reverse-proxy path prefix, e.g. /dontstop.
DONTSTOP_BASE_PATH=

# Local/internal gateway URL for the local endpoint row.
DONTSTOP_LOCAL_BASE_URL=http://localhost:8080

# Enable only when the admin is behind a known trusted reverse proxy.
DONTSTOP_TRUST_PROXY=off
