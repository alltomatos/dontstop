DONTSTOP_HOST=dontstop.alltomatos.dev.br
DONTSTOP_PUBLIC_BASE_URL=https://dontstop.alltomatos.dev.br
# Obrigatória: gere com `openssl rand -hex 24`
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379/0
# Obrigatória: chave-mestra AES-256-GCM, gere com `openssl rand -base64 32`
MASTER_KEY=

# Guia do usuário: local (HTML embutido) ou github (busca o markdown no repositório em runtime)
DONTSTOP_GUIDE_SOURCE=local
DONTSTOP_GUIDE_REPO=alltomatos/dontstop
DONTSTOP_GUIDE_REF=main
DONTSTOP_GUIDE_CACHE_TTL_SECONDS=60
